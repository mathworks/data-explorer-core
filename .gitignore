node_modules/
coverage/
*.tgz
.DS_Store

# Throwaway probes run against src/ — a fixture experiment, not a test. Relative imports
# resolve from here, which is why they live in the repo rather than in /tmp.
.scratch/

# NOTE: dist/ is intentionally committed (not ignored). This package is consumed
# as a git dependency, and enterprise npm setups often set `ignore-scripts=true`,
# which skips the `prepare` build on install. Shipping a prebuilt dist/ makes the
# git dependency resolve unconditionally. Rebuild with `npm run build` before
# committing source changes (CI `verify` enforces it).

# Internal working notes — never publish to the public tree.
docs/
CLAUDE.md

# Performance-harness corpus manifest. It names real files on one machine, and real
# dictionaries carry customer identities that must never reach this public tree —
# scripts/leak-check.mjs asserts none of its paths appear in a tracked file. Start
# from perf/corpus.local.example.json, which is tracked and names nothing.
perf/corpus.local.json

# Performance snapshots are machine-specific: perf/compare.mjs refuses to diff runs
# from different CPUs or corpora, so a committed snapshot helps nobody. Record your
# own before/after pair around a change.
perf/baselines/
